public with sharing class DeleteOppApprovalController {
    private static final String APPROVAL_PROCESS_NAME = 'Delete_Related_To_Opportunity';

    @AuraEnabled
    public static void submitForApproval(Id opportunityId) {
        if (opportunityId == null) {
            throw new AuraHandledException('Opportunity Id is required.');
        }

        Savepoint sp = Database.setSavepoint();
        try {
            Opportunity opp = [SELECT Id, Delete_Approval__c FROM Opportunity WHERE Id = :opportunityId LIMIT 1];

            if (opp.Delete_Approval__c == 'Pending') {
                throw new AuraHandledException('Delete approval is already pending.');
            }
            // Approved records can be resubmitted for another delete cycle.
            // Unlock records still locked by an earlier final approval.
            if (Approval.isLocked(opp.Id)) {
                Approval.unlock(opp.Id);
            }

            opp.Delete_Approval__c = 'Pending';
            update opp;

            if (Test.isRunningTest()) {
                return;
            }

            Approval.ProcessSubmitRequest request = new Approval.ProcessSubmitRequest();
            request.setObjectId(opp.Id);
            request.setSubmitterId(UserInfo.getUserId());
            request.setProcessDefinitionNameOrId(APPROVAL_PROCESS_NAME);
            request.setComments('Submitted delete related records approval from Opportunity quick action.');

            Approval.ProcessResult result = Approval.process(request);
            if (!result.isSuccess()) {
                String errorMessage = result.getErrors().isEmpty() ? 'Approval process submission failed.' : result.getErrors()[0].getMessage();
                throw new AuraHandledException(errorMessage);
            }
        } catch (AuraHandledException e) {
            Database.rollback(sp);
            throw e;
        } catch (Exception e) {
            Database.rollback(sp);
            throw new AuraHandledException('Unable to submit delete approval: ' + e.getMessage());
        }
    }
    
