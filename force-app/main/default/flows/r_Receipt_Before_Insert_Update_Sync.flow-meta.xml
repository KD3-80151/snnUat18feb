    <assignments>
        <name>Rcvd_Amt</name>
        <label>RcvdAmt</label>
        <locationX>176</locationX>
        <locationY>287</locationY>
        <assignmentItems>
            <assignToReference>rcvdAMt</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>$Record.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Tax_Percentage</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>cgstValue</name>
        <dataType>Currency</dataType>
        <expression>({!newAmount}*{!Get_Tax_Percentage.CGST__c})/100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>newAmount</name>
        <dataType>Currency</dataType>
        <expression>(({!rcvdAMt}*100)/({!Get_Tax_Percentage.CGST__c}+{!Get_Tax_Percentage.SGST__c}+100))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>sgstValue</name>
        <dataType>Currency</dataType>
        <expression>({!newAmount}*{!Get_Tax_Percentage.SGST__c})/100</expression>
        <scale>2</scale>
    </formulas>
